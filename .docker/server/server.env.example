# Plantilla del `.env` de un entorno de servidor: /srv/pintech/<entorno>/.env (dueño root, permisos 600).
# Lo leen compose.yaml (imagen, base de datos y límites) y Laravel (env_file). Uno por entorno: NUNCA copiar el de
# producción a staging ni al revés. Los secretos se guardan también en el gestor de contraseñas.
#
# Lo que cambia entre entornos está marcado con «staging | prod».

# --- Compose ---------------------------------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=pintech-staging              # staging: pintech-staging | prod: pintech-prod
# Lo escribe pintech-deploy en cada despliegue. No se edita a mano.
APP_IMAGE=

# Límites por servicio (scheduler y túnel tienen límites fijos pequeños en compose.yaml).
# staging, 1,5 vCPU y 3 GB en total:  web 0.6 / 1G,  queue 0.3 / 512M, postgres 0.4 / 1G
# prod,    4 vCPU y 7 GB en total:    web 1.75 / 3G, queue 0.75 / 1G,  postgres 1 / 2G
WEB_CPUS=0.6
WEB_MEMORY=1G
QUEUE_CPUS=0.3
QUEUE_MEMORY=512M
POSTGRES_CPUS=0.4
POSTGRES_MEMORY=1G

# --- Laravel ---------------------------------------------------------------------------------------------------------
APP_NAME="Pintech Colombia S.A.S."
APP_ENV=staging                                   # staging | production
# `php artisan key:generate --show` en un contenedor suelto. Sin ella no se descifran sesiones ni datos cifrados:
# guárdala en el gestor de contraseñas. No cambia entre despliegues.
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.beprocoatingserp.com      # staging | https://app.beprocoatingserp.com

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=pintech_erp
DB_USERNAME=pintech
# Larga y aleatoria (por ejemplo `openssl rand -hex 32`). Se fija al crear la base: cambiarla después pide cambiarla
# también dentro de PostgreSQL.
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
# El túnel entrega todo por HTTPS: la cookie de sesión solo viaja cifrada.
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# Staging escribe los correos en el log; producción define su proveedor antes de salir.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@beprocoatingserp.com"
MAIL_FROM_NAME="${APP_NAME}"

# Consecutivos iniciales de la planta (ver config/). Solo importan en una base nueva.
# PRODUCTION_ORDER_LOT_START=
# QUOTATION_START_NUMBER=
