.git
node_modules
# Ningún .env entra en la imagen (.env.production, .env.backup…), salvo el ejemplo.
.env*
!.env.example
.vite
vendor
public/hot
# El enlace de storage del equipo local: la imagen crea el suyo.
public/storage
**/.DS_Store
# Cachés de Laravel del equipo local (config, rutas, paquetes de desarrollo): la imagen genera las suyas.
bootstrap/cache/*.php
# De storage solo entran las carpetas (sus .gitignore): nada de lo que dejó el equipo local (sesiones, logs, cachés,
# temporales de Excel, registros de Inertia DevTools, archivos subidos).
storage/**
!storage/**/.gitignore
*.md


# Test and CI files - not needed in production images
tests/
.github/
coverage/
.phpunit.*
phpunit.xml

# Documentation and assets
docs/
imagenes/

# AI agent configs
.agents/
.claude/
.codex/
.cursor/

# Dev IDE/editor configs
.vscode/
.idea/
.editorconfig
.prettierignore
.prettierrc
eslint.config.js

# Scripts y plantillas del servidor (no van dentro de la imagen)
.docker/server/

# Docker compose orchestration files
compose.dev.yaml
compose.prod.yaml